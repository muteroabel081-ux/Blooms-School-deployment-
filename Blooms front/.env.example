# ══════════════════════════════════════════════════════════
# BLOOMS Junior School — Frontend Environment Variables
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# .env is already in .gitignore — NEVER commit it.

# ── Database ─────────────────────────────────────────────
# Local SQLite (default for development)
DATABASE_URL=file:./prisma/db/custom.db

# Turso (hosted SQLite for production)
# Get these values from:
#   turso db create blooms-frontend
#   turso db show blooms-frontend --url
#   turso db tokens create blooms-frontend
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Vercel Postgres (alternative — requires provider="postgresql" in schema.prisma)
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# ── NextAuth ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3001
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# or: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# ── File Uploads ──────────────────────────────────────────
# Max upload size in bytes (default 10MB)
# UPLOAD_MAX_SIZE=10485760
