# ══════════════════════════════════════════════════════════
# BLOOMS Junior School - Environment Variables
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# .env is already in .gitignore — never commit it.

# ── Database: Turso (active) ─────────────────────────────
# Get these two values by running, after installing the Turso CLI:
#   turso db create blooms-junior
#   turso db show blooms-junior --url
#   turso db tokens create blooms-junior
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# ── Database: local SQLite (uncomment for offline dev) ───
# When using this, DATABASE_AUTH_TOKEN is not needed —
# src/lib/prisma.ts passes it as undefined, which the libsql
# client ignores for file:// URLs.
# DATABASE_URL=file:./db/custom.db

# ── Database: Vercel Postgres (alternative, not what this
#    schema/adapter setup targets — would need provider =
#    "postgresql" in schema.prisma and a different adapter) ─
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32
